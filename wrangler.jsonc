{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pigeon-skin",
  "main": "apps/server/src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // ── Smart Placement ────────────────────────────────────────────────────────
  // D1 固定单一区域，每个请求至少一次 D1 往返（会话解析、设置缓存未命中）；
  // smart 让 Worker 计算靠近 D1 部署。静态资产仍由边缘直接服务，不受影响。
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.25,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  "queues": {
    "producers": [{ "binding": "SEARCH_SUBMISSIONS", "queue": "pigeon-search-prod" }, { "binding": "EMAIL_NOTIFICATIONS", "queue": "pigeon-email-prod" }],
    "consumers": [{ "queue": "pigeon-search-prod", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 3, "max_concurrency": 1, "dead_letter_queue": "pigeon-search-dlq-prod" }, { "queue": "pigeon-email-prod", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 5, "max_concurrency": 1, "dead_letter_queue": "pigeon-email-dlq-prod" }]
  },

  // ── 静态资源（前端 SPA）──────────────────────────────────────────────────
  // 前端构建产物直接挂在 Worker 上：API 与 SPA 同源，Cookie/协议路径零 CORS。
  // not_found_handling = none：资产层对缺失文件回 404，不回 index.html ——
  // 否则 /assets/过期hash.js 这类缺失文件会拿到被 _headers 标 immutable 的
  // 回退 HTML。SPA 深链由 Worker 的 notFound 处理器显式取 index.html 做
  // SEO 预渲染（Node 自托管侧 shim 语义见 src/node/assets.ts）。
  // run_worker_first 用「包含一切、按目录排除」的数组：HTML 深链、协议与 SEO
  // 端点（/{player}.json、/sitemap-N.xml 等）仍先过 Worker（SEO 预渲染与反爬
  // 守卫依赖它），而 hashed 产物、blockbench 静态页、live2d 模型、手册截图等
  // 纯静态文件由资产层直接服务，不计 Worker 请求。被排除路径的安全头与
  // /assets 的 immutable 缓存声明在 apps/web/public/_headers 里。
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/blockbench/*",
      "!/live2d/*",
      "!/manual/*.jpg",
      "!/manual/*.png",
      "!/manual/*.webp",
      "!/manual-content.json",
      "!/manual-content.en.json",
      "!/manual-content.zh_TW.json",
      "!/manual-content.es_ES.json",
      "!/manual-content.ru_RU.json",
      "!/manual-content.ja_JP.json",
      "!/third-party/*",
      "!/beian.svg",
      "!/editor-bridge.js",
      "!/editor-language.js",
      "!/skin-editor.css"
    ],
    "not_found_handling": "none"
  },

  // ── AI（Workers AI，按请求计费，无固定费用）────────────────────────────────
  "ai": {
    "binding": "AI"
  },

  // ── 衍生图生成（SQLite DO，免费层可用）────────────────────────────────────
  // 按 hash 命名实例化：同名请求被 input gates 串行化，
  // 充当"每个衍生图只生成一次"的分布式锁。见 src/do/derivatives.ts。
  "durable_objects": {
    "bindings": [
      { "name": "DERIVATIVES", "class_name": "DerivativeGenerator" },
      { "name": "OFFICIAL_RESOURCES", "class_name": "OfficialResourceUpdater" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DerivativeGenerator"] },
    { "tag": "v2", "new_sqlite_classes": ["OfficialResourceUpdater"] }
  ],

  // ── 本地开发 ────────────────────────────────────────────────────────────────
  // 本地 D1 与本地 R2 都是文件型的，不需要网络、不需要 Docker、不需要账号。
  // npm run dev 同时启动前端、后端与本地存储。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bs-prod",
      // 省略 database_id：按名字自动连接账户里已有的库，不存在时自动创建
      "migrations_dir": "packages/db/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "bs-prod-textures" }
  ],
  // 原生 Rate Limiting binding：边缘限流，无存储、无成本。
  // RL_GLOBAL 防扫描（200 req/10s/IP），RL_AUTH 管认证端点（30 req/min/IP）；
  // RL_SKINLIB / RL_SKINLIB_USER 管皮肤库列表/详情——匿名访客按 IP 紧桶
  //（60 req/min），登录用户按账号松桶（300 req/min）。
  // 中间件在 binding 缺失或 RATE_LIMIT_ENABLED 关闭时 fail-open。
  "ratelimits": [
    { "name": "RL_GLOBAL", "namespace_id": "1001", "simple": { "limit": 200, "period": 10 } },
    { "name": "RL_AUTH", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_SKINLIB", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_SKINLIB_USER", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "DERIVATIVES_ENABLED": "true",
    "APP_URL": "https://skin.pigeon-server.cn"
  },

  // ── 预览环境 ────────────────────────────────────────────────────────────────
  // 硬规则：预览环境绝不绑定生产的 D1 或 R2（见 docs/rewrite/02-architecture.md §7）。
  "env": {
    // ── 本地开发 ──────────────────────────────────────────────────────────────
    // 本地 D1 与本地 R2 都是文件型的，不需要网络。npm run dev --env dev。
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bs-dev",
          "database_id": "local-dev-placeholder",
          "migrations_dir": "packages/db/migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "BUCKET", "bucket_name": "bs-dev-textures" }
      ],
      "queues": {
        "producers": [{ "binding": "SEARCH_SUBMISSIONS", "queue": "pigeon-search-dev" }, { "binding": "EMAIL_NOTIFICATIONS", "queue": "pigeon-email-dev" }],
        "consumers": [{ "queue": "pigeon-search-dev", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 3, "max_concurrency": 1, "dead_letter_queue": "pigeon-search-dlq-dev" }, { "queue": "pigeon-email-dev", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 5, "max_concurrency": 1, "dead_letter_queue": "pigeon-email-dlq-dev" }]
      },
      "vars": {
        "ENVIRONMENT": "development",
        "DERIVATIVES_ENABLED": "true"
      }
    },
    "preview": {
      "name": "pigeon-skin-preview",
      "queues": {
        "producers": [{ "binding": "SEARCH_SUBMISSIONS", "queue": "pigeon-search-preview" }, { "binding": "EMAIL_NOTIFICATIONS", "queue": "pigeon-email-preview" }],
        "consumers": [{ "queue": "pigeon-search-preview", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 3, "max_concurrency": 1, "dead_letter_queue": "pigeon-search-dlq-preview" }, { "queue": "pigeon-email-preview", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 5, "max_concurrency": 1, "dead_letter_queue": "pigeon-email-dlq-preview" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bs-preview",
          // 同 production：按名字自动连接/创建，首次部署时 provisioning
          "migrations_dir": "packages/db/migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "BUCKET", "bucket_name": "bs-preview-textures" }
      ],
      "ai": { "binding": "AI" },
      // durable_objects binding 不被 wrangler 环境继承，必须每个 env 显式声明
      "durable_objects": {
        "bindings": [
          { "name": "DERIVATIVES", "class_name": "DerivativeGenerator" },
          { "name": "OFFICIAL_RESOURCES", "class_name": "OfficialResourceUpdater" }
        ]
      },
      "ratelimits": [
        { "name": "RL_GLOBAL", "namespace_id": "1101", "simple": { "limit": 200, "period": 10 } },
        { "name": "RL_AUTH", "namespace_id": "1102", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_SKINLIB", "namespace_id": "1103", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_SKINLIB_USER", "namespace_id": "1104", "simple": { "limit": 300, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "preview",
        "DERIVATIVES_ENABLED": "true"
        // APP_URL 待预览环境有确定域名后在此填写
      }
    },

  }
}